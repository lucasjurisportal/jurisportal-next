# Banco
DATABASE_URL=""
DIRECT_URL=""

# Autenticação
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# E-mail
RESEND_API_KEY=""
RESEND_FROM="Jurisportal Next <onboarding@resend.dev>"

# Google Calendar OAuth
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/integrations/google-calendar/callback"
# Segredo independente usado para cifrar access/refresh tokens no PostgreSQL.
# Gere localmente com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_CALENDAR_TOKEN_KEY=""

# Agendamentos internos
# Segredo usado para autorizar rotas de cron. Em produção, configure como variável secreta.
CRON_SECRET=""

# Atendimento
# E-mail interno que recebe as solicitações enviadas pelo formulário de suporte.
JURISPORTAL_SUPPORT_EMAIL=""

# Documentos (Cloudflare R2). Nunca use NEXT_PUBLIC_ nessas chaves.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="jurisportal-staging"
# Se vazio, usa https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=""

# Só habilite após backup de banco + R2 estar configurado e RESTAURAÇÃO testada.
# Permite exclusão definitiva de PDFs pelo proprietário (não altera exclusão de processos).
DOCUMENT_PERMANENT_DELETE_ENABLED="false"
