# Banco
DATABASE_URL=""
DIRECT_URL=""

# Consulta processual complementar, DESATIVADA por padrão. Não habilitar DataJud público
# comercialmente sem autorização aplicável e validação jurídica da Portaria CNJ 374/2026.
PROCESS_LOOKUP_PROVIDER=disabled
DATAJUD_ACCESS_AUTHORIZED=false
DATAJUD_COMMERCIAL_AUTHORIZATION_CONFIRMED=false
# DATAJUD_API_KEY= # chave pública vigente publicada na wiki CNJ; configuração servidor

# Autenticação
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# E-mail
RESEND_API_KEY=""
RESEND_FROM="Jurisportal <notificacoes@seu-dominio-verificado.com.br>"

# Google Calendar OAuth
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/integrations/google-calendar/callback"
# Segredo independente usado para cifrar access/refresh tokens no PostgreSQL.
# Gere localmente com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_CALENDAR_TOKEN_KEY=""

# Agendamentos internos
# Segredo usado para autorizar rotas de cron. Em produção, configure como variável secreta.
CRON_SECRET=""

# Atendimento
# E-mail interno que recebe as solicitações enviadas pelo formulário de suporte.
JURISPORTAL_SUPPORT_EMAIL=""

# Documentos (Cloudflare R2). Nunca use NEXT_PUBLIC_ nessas chaves.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="jurisportal-staging"
# Se vazio, usa https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=""

# Só habilite após backup de banco + R2 estar configurado e RESTAURAÇÃO testada.
# Permite exclusão definitiva de PDFs pelo proprietário (não altera exclusão de processos).
DOCUMENT_PERMANENT_DELETE_ENABLED="false"

# v39.7: backup de PDFs em um bucket DIFERENTE, com token restrito ao bucket backup.
R2_BACKUP_ACCOUNT_ID=""
R2_BACKUP_ACCESS_KEY_ID=""
R2_BACKUP_SECRET_ACCESS_KEY=""
R2_BACKUP_BUCKET="jurisportal-backup"
# Para não misturar staging e produção no mesmo bucket de backup.
R2_BACKUP_PREFIX="staging"
# Opcional; quando vazio usa https://<R2_BACKUP_ACCOUNT_ID ou R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BACKUP_ENDPOINT=""
# Recuperação de produção é operação de emergência e exige autorização explícita.
BACKUP_ALLOW_PRODUCTION_RESTORE="false"

# v55: chave e remetente reais devem ser configurados EM .env.local no staging;
# teste: npm run diagnose:publication-email (não envia, não mostra credenciais).
# Confira o domínio no painel Resend e faça envio controlado antes de habilitar clientes.
# manter false até teste com advogado fictício e domínio Resend verificado.
# A captura manual gera a fila mesmo com e-mail desativado.
PUBLICATION_EMAIL_ENABLED="false"
# URL usada somente para link de acesso no e-mail, nunca para disparar CRON.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Opcional, apenas se diagnose:datajud:network apontar IPv4/TLS OK e IPv6 sem rota.
# DATAJUD_FORCE_IPV4=false

# v62: IA assistiva server-side. Permanece desligada até homologação controlada.
# Nunca use NEXT_PUBLIC_ para a chave do provedor.
AI_PROVIDER_ENABLED="false"
OPENAI_API_KEY=""
# IDs verificados na documentação oficial em 26/09/2026; mantenha configuráveis no ambiente.
OPENAI_MODEL_LUNA="gpt-5.6-luna"
OPENAI_MODEL_TERRA="gpt-5.6-terra"
