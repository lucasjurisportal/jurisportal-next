    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "17.4.2",
    "pg": "8.17.2",
    "better-auth": "1.7.5",
    "@better-auth/prisma-adapter": "1.7.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "typescript": "latest",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "tsx": "4.20.6"
  }
}
